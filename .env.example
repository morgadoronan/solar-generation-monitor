# Copy to .env for local development. Never commit real household or credential values.
RENOVIGI_USERNAME=your-renovigi-username
RENOVIGI_PASSWORD=your-renovigi-password
RENOVIGI_PLANT_ID=your-plant-id
SOLAR_LATITUDE=-00.0000
SOLAR_LONGITUDE=-00.0000
SOLAR_TIMEZONE=Area/City
SOLAR_BASELINE_DATE=YYYY-MM-DD
SOLAR_ENERGY_RATE_BRL_PER_KWH=0.95
DEFAULT_BRANCH=main
ENABLE_LIVE_MONITORING=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
